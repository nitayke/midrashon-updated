rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /midrashot/{midrashaId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /student_submissions_midrashon/{submissionId} {
      allow create: if request.resource.data.midrasha_name is string 
                    && request.resource.data.midrasha_name.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    match /midrasha_requests/{requestId} {
      allow create: if request.resource.data.midrasha_name is string 
                    && request.resource.data.midrasha_name.size() > 0;
      allow read, update, delete: if request.auth != null;
    }

    match /contact_leads_midrashon/{leadId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /all_test_results_midrashon/{testId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

  }
}

